<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Basic Add-in Info -->
  <!-- Unique add-in ID. Generate a new one with: [guid]::NewGuid() in PowerShell. Do NOT change after first deployment. -->
  <Id>d3334e9d-96d1-402c-8fda-b9f5774135b3</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Luftfracht Rechner</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="Luftfracht Rechner" />
  <Description DefaultValue="Volumen und Chargeable Weight für Luftfrachtsendungen berechnen" />
  <!-- Replace with your own icon hosted on GitHub Pages. See README.md for details. -->
  <IconUrl DefaultValue="https://officeimg.vo.msecnd.net/images/APP_Logo_512.png" />
  <HighResolutionIconUrl DefaultValue="https://officeimg.vo.msecnd.net/images/APP_Logo_512.png" />
  <SupportUrl DefaultValue="https://github.com" />

  <!-- Hosts: This add-in targets Outlook -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <!-- Requirements -->
  <Requirements>
    <Sets>
      <Set Name="MailBox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <!-- Form Settings (legacy fallback) -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://andreas-schmidt-ux.github.io/luftfracht-rechner/index.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://andreas-schmidt-ux.github.io/luftfracht-rechner/index.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- Permissions -->
  <Permissions>ReadWriteItem</Permissions>

  <!-- Rule: show in all mail items -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- VersionOverrides: Ribbon button for Read and Compose -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">

        <DesktopFormFactor>

          <!-- Shared function file (not needed for taskpane-only, but required by schema) -->
          <FunctionFile resid="FunctionFile.Url" />

          <!-- MessageRead Surface -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="msgReadOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- MessageCompose Surface -->
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgComposeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="msgComposeOpenPaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId2</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <!-- Resources -->
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://officeimg.vo.msecnd.net/images/APP_Logo_512.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://officeimg.vo.msecnd.net/images/APP_Logo_512.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://officeimg.vo.msecnd.net/images/APP_Logo_512.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="FunctionFile.Url" DefaultValue="https://andreas-schmidt-ux.github.io/luftfracht-rechner/index.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://andreas-schmidt-ux.github.io/luftfracht-rechner/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Luftfracht" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Luftfracht Rechner" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Volumen und Chargeable Weight für Luftfrachtsendungen berechnen" />
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>

</OfficeApp>
